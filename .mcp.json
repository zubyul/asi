{
  "mcpServers": {
    "signal-mcp": {
      "type": "stdio",
      "command": "/opt/signal-mcp/.venv/bin/python",
      "args": ["/opt/signal-mcp/main.py", "--user-id", "YOUR_PHONE_NUMBER", "--transport", "stdio"],
      "disabled": true
    },
    "signal-reader": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--with", "mcp[cli]", "--with", "signal-export", "mcp", "run", "/opt/signal-mcp-server/server.py"],
      "disabled": true
    },
    "telegram-mcp": {
      "type": "stdio",
      "command": "/opt/telegram-mcp/.venv/bin/python",
      "args": ["-m", "telegram_mcp"],
      "env": {
        "TELEGRAM_API_ID": "YOUR_API_ID",
        "TELEGRAM_API_HASH": "YOUR_API_HASH",
        "TELEGRAM_PHONE": "+1YOURPHONE"
      },
      "disabled": true
    },
    "twilio-sms": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@yiyang.1i/sms-mcp-server"],
      "env": {
        "ACCOUNT_SID": "YOUR_TWILIO_SID",
        "AUTH_TOKEN": "YOUR_TWILIO_TOKEN",
        "FROM_NUMBER": "+1YOURTWILIONUMBER"
      },
      "disabled": true
    },
    "innervoice": {
      "type": "stdio",
      "command": "node",
      "args": ["/opt/innerVoice/src/mcp-server.js"],
      "env": {
        "TELEGRAM_BOT_TOKEN": "YOUR_BOT_TOKEN",
        "TELEGRAM_CHAT_ID": "YOUR_CHAT_ID"
      },
      "disabled": true
    }
  }
}
